# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.npm-cache

# claude code local session state
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Personal-use candidate fonts (dafont) — evaluate locally, do not redistribute
/public/fonts/candidates/

# Raw photo drops / intermediates — only the optimized outputs are committed
/public/assets/activities-src/
/public/assets/drive-download-*.zip
/public/assets/*.HEIC
/public/assets/*.heic

# Pinterest / mood-board inspo — private colour reference ONLY, never published
# (third-party copyright; used locally to sample palette, must not deploy)
/public/assets/_*.jpeg
/public/assets/_*.jpg

# Purchased font source files (webfont license) — keep out of git & web root
/licenses/

# stray GitHub Desktop clone (do not track)
/Wedding-Planner/
